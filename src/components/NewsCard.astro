---
import type {CollectionEntry} from 'astro:content';import {language,pathFor,contentFor} from '../lib/content';const lang=language(Astro.url),ui=contentFor(lang).ui;
interface Props {article:CollectionEntry<'news'>}
const {article}=Astro.props;
---
<article class="card news-card"><a href={pathFor(`/news/${article.data.slug}`,lang)}><img src={article.data.mainControl.coverImage} alt={article.data.coverImageAlt} width="700" height="520" loading="lazy"/><div class="card-body"><time datetime={article.data.mainControl.publishDate.toISOString()}>{article.data.mainControl.publishDate.toLocaleDateString(lang==='kh'?'km-KH':'en-US',{day:'numeric',month:'long',year:'numeric'})}</time><h3>{article.data.title}</h3><p>{article.data.summary}</p><span class="text-link">{ui.actions.readStory} <span aria-hidden="true">↗</span></span></div></a></article>
