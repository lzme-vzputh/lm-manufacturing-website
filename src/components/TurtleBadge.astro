---
interface Props {
  title?: string;
  subtitle?: string;
  compact?: boolean;
}
const {
  title = 'Turtle Packaging',
  subtitle = 'Signature pack concept',
  compact = false,
} = Astro.props;
---
<div class:list={["turtle-badge", compact && 'turtle-badge-compact']}>
  <span class="turtle-icon-wrap" aria-hidden="true">
    <svg class="turtle-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="30" cy="33" rx="17" ry="13" fill="currentColor" opacity=".18"/>
      <ellipse cx="30" cy="33" rx="17" ry="13" stroke="currentColor" stroke-width="3"/>
      <circle cx="49" cy="32" r="5.5" fill="currentColor" opacity=".18"/>
      <circle cx="49" cy="32" r="5.5" stroke="currentColor" stroke-width="3"/>
      <circle cx="21" cy="20" r="4.5" fill="currentColor" opacity=".18"/>
      <circle cx="39" cy="20" r="4.5" fill="currentColor" opacity=".18"/>
      <circle cx="21" cy="46" r="4.5" fill="currentColor" opacity=".18"/>
      <circle cx="39" cy="46" r="4.5" fill="currentColor" opacity=".18"/>
      <circle cx="21" cy="20" r="4.5" stroke="currentColor" stroke-width="3"/>
      <circle cx="39" cy="20" r="4.5" stroke="currentColor" stroke-width="3"/>
      <circle cx="21" cy="46" r="4.5" stroke="currentColor" stroke-width="3"/>
      <circle cx="39" cy="46" r="4.5" stroke="currentColor" stroke-width="3"/>
      <path d="M10 34 5 30l1 7 4-3Z" fill="currentColor" opacity=".18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <circle cx="26" cy="28" r="4" stroke="white" stroke-width="2.5"/>
      <circle cx="34" cy="26" r="3.8" stroke="white" stroke-width="2.5"/>
      <circle cx="38" cy="34" r="3.7" stroke="white" stroke-width="2.5"/>
      <circle cx="28" cy="37" r="4.2" stroke="white" stroke-width="2.5"/>
      <circle cx="49.8" cy="30.5" r="1" fill="currentColor"/>
    </svg>
  </span>
  <span class="turtle-copy">
    <strong>{title}</strong>
    <small>{subtitle}</small>
  </span>
</div>
