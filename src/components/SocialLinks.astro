---
type Network = 'linkedin' | 'telegram' | 'youtube' | 'facebook';
interface Props {
  social?: Partial<Record<Network, string>>;
  lang?: 'en' | 'kh';
  showUnlinked?: boolean;
}
const { social = {}, lang = 'en', showUnlinked = false } = Astro.props;
const networks: Network[] = ['linkedin', 'telegram', 'youtube', 'facebook'];
const hosts: Record<Network, string[]> = {
  linkedin: ['linkedin.com'],
  telegram: ['t.me', 'telegram.me'],
  youtube: ['youtube.com', 'youtu.be'],
  facebook: ['facebook.com', 'fb.com'],
};
function validUrl(network: Network, value?: string): string | undefined {
  if (!value?.trim()) return;
  try {
    const url = new URL(value.trim());
    if (url.protocol !== 'https:' || !hosts[network].some(host => url.hostname === host || url.hostname.endsWith(`.${host}`))) return;
    return url.href;
  } catch { return; }
}
const links = networks.map(network => ({network, url: validUrl(network, social[network])})).filter(item => item.url || showUnlinked);
const unavailable = lang === 'kh' ? 'មិនទាន់មានតំណភ្ជាប់' : 'Link not available yet';
const icons: Record<Network, string> = {
  linkedin: '<path d="M5.2 3a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4ZM3.3 9h3.8v12H3.3V9Zm5.8 0h3.6v1.6h.1A4 4 0 0 1 16.4 8c3.9 0 4.6 2.4 4.6 5.6V21h-3.8v-6.6c0-1.6 0-3.6-2.2-3.6s-2.5 1.7-2.5 3.5V21H9.1V9Z"/>',
  telegram: '<path d="M21.8 3.7a1 1 0 0 0-1.1-.1L2.5 10.7a1 1 0 0 0 .1 1.9l4.9 1.6 1.7 5.2a1 1 0 0 0 1.7.4l2.8-3 4.2 3.1a1 1 0 0 0 1.6-.6l2.7-14.6a1 1 0 0 0-.4-1Zm-4 13.6-4-3a1 1 0 0 0-1.3.1l-1.6 1.7.4-2.8 7.6-6.8-9.4 6-3.6-1.2 14-5.4-2.1 11.4Z"/>',
  youtube: '<path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.9 4.8 12 4.8 12 4.8s-5.9 0-7.6.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.4 7.6.4 7.6.4s5.9 0 7.6-.4a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8ZM10 15.1V8.9l5.5 3.1-5.5 3.1Z"/>',
  facebook: '<path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6a22 22 0 0 0-2.5-.1C11.8 3.5 10 5 10 7.8v2.1H7.3V13H10v8h3.5Z"/>',
};
---
{links.length > 0 && <ul class="social-links" aria-label={lang === 'kh' ? 'បណ្ដាញសង្គម' : 'Social media'}>
  {links.map(({network, url}) => <li>
    {url ? <a href={url} target="_blank" rel="noopener noreferrer" aria-label={network} title={network}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><Fragment set:html={icons[network]} /></svg>
      <span>{network}</span>
    </a> : <span class="social-unlinked" aria-label={`${network}: ${unavailable}`} title={`${network}: ${unavailable}`}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><Fragment set:html={icons[network]} /></svg>
      <span>{network}</span>
    </span>}
  </li>)}
</ul>}
