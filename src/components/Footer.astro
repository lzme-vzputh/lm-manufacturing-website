---
import {siteFor,language,pathFor,contentFor} from '../lib/content';const lang=language(Astro.url),site=siteFor(lang),ui=contentFor(lang).ui;
import {publicEntries,productsFor} from '../lib/content';
import SocialLinks from './SocialLinks.astro';
const products=publicEntries(await productsFor(lang)).sort((a,b)=>a.data.displayOrder-b.data.displayOrder).slice(0,4);
---
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand footer-brand" href={pathFor('/',lang)}><img src={site.logo} width="40" height="40" alt=""/>{site.companyName}</a><p>{site.description}</p></div><div><h2>{ui.headings.explore}</h2><ul><li><a href={pathFor('/about',lang)}>{ui.nav.about}</a></li><li><a href={pathFor('/factory',lang)}>{ui.nav.factory}</a></li><li><a href={pathFor('/news',lang)}>{ui.nav.news}</a></li><li><a href={pathFor('/careers',lang)}>{ui.nav.careers}</a></li></ul></div><div><h2>{ui.nav.products}</h2><ul>{products.map(item=><li><a href={pathFor(`/products/${item.data.slug}`,lang)}>{item.data.title}</a></li>)}<li><a href={pathFor('/products',lang)}>{ui.actions.allProducts}</a></li></ul></div><div><h2>{ui.nav.contact}</h2><address>{site.contact.address}</address>{site.contact.phone && <p><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></p>}{site.contact.email && <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>}<SocialLinks social={site.social} lang={lang} /></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.footer.copyright}</span><a href={pathFor('/contact',lang)}>{ui.actions.getInTouch}</a></div></footer>
