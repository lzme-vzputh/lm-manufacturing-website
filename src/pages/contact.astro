---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import {contact,site} from '../lib/content';
const social=Object.entries(site.social).filter(([,url])=>url);
---
<BaseLayout title="Contact" description={contact.hero.description}><Hero {...contact.hero}/><section class="section"><div class="container split"><div><p class="eyebrow">GET IN TOUCH</p><h2>{contact.ctaTitle}</h2><p>{contact.ctaText}</p><dl class="contact-details"><dt>Address</dt><dd>{site.contact.address}</dd>{site.contact.phone && <><dt>Phone</dt><dd><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></dd></>}{site.contact.email && <><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></>}<dt>Business hours</dt><dd>{site.contact.businessHours}</dd></dl><ul class="social-links">{social.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ul></div><div>{contact.mapEmbedUrl?<iframe title="Company location map" src={contact.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="map-embed"></iframe>:<div class="map-placeholder"><strong>{site.companyName}</strong><span>{site.contact.address}</span></div>}</div></div></section></BaseLayout>
