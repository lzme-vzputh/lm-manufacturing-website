---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import SocialLinks from '../components/SocialLinks.astro';import {contentFor,language,pathFor,siteFor} from '../lib/content';
const lang=language(Astro.url),{contact,ui}=contentFor(lang),site=siteFor(lang);
---
<BaseLayout title={ui.nav.contact} description={contact.hero.description}><Hero {...contact.hero}/><section class="section"><div class="container split"><div><p class="eyebrow">{ui.actions.getInTouch}</p><h2>{contact.ctaTitle}</h2><p>{contact.ctaText}</p><dl class="contact-details"><dt>{ui.headings.address}</dt><dd>{site.contact.address}</dd>{site.contact.phone && <><dt>{ui.headings.phone}</dt><dd><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></dd></>}{site.contact.email && <><dt>{ui.headings.email}</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></>}<dt>{ui.headings.businessHours}</dt><dd>{site.contact.businessHours}</dd></dl><SocialLinks social={site.social} lang={lang} showUnlinked /></div><div>{contact.mapEmbedUrl?<iframe title="Company location map" src={contact.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="map-embed"></iframe>:<div class="map-placeholder"><strong>{site.companyName}</strong><span>{site.contact.address}</span></div>}</div></div></section></BaseLayout>
