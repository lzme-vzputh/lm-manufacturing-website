---
import ArticleLayout from '../../layouts/ArticleLayout.astro';import {getCollection,render} from 'astro:content';import {publicEntries,site} from '../../lib/content';export async function getStaticPaths(){return publicEntries(await getCollection('careers')).map(job=>({params:{slug:job.data.slug},props:{job}}));}const {job}=Astro.props;const {Content}=await render(job);const applicationEmail=site.contact.applicationEmail||site.contact.email;
---
<ArticleLayout title={job.data.title} description={job.data.summary} date={job.data.publishDate} section="Careers" sectionUrl="/careers"><p class="lead">{job.data.department} · {job.data.location} · {job.data.employmentType}</p>{job.data.closingDate && <p>Closing date: <time datetime={job.data.closingDate.toISOString()}>{job.data.closingDate.toLocaleDateString('en-US',{day:'numeric',month:'long',year:'numeric'})}</time></p>}<div class="prose"><Content/><h2>Responsibilities</h2><ul>{job.data.responsibilities.map(item=><li>{item}</li>)}</ul><h2>Requirements</h2><ul>{job.data.requirements.map(item=><li>{item}</li>)}</ul></div><div class="notice application-notice"><h2>Apply for this role</h2>{applicationEmail?<p>Email your CV to <a href={`mailto:${applicationEmail}?subject=${encodeURIComponent(`Application: ${job.data.title}`)}`}>{applicationEmail}</a> and include the job title in the subject.</p>:<p>Please use our <a href="/contact">contact page</a> to ask about applying.</p>}</div></ArticleLayout>
