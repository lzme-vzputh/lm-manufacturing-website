---
import ArticleLayout from '../../layouts/ArticleLayout.astro';import {getCollection,render} from 'astro:content';import {publicEntries,language,contentFor,pathFor,siteFor} from '../../lib/content';export async function getStaticPaths(){return publicEntries(await getCollection('careers')).map(job=>({params:{slug:job.data.slug},props:{job}}));}const lang=language(Astro.url),ui=contentFor(lang).ui;const {job}=Astro.props;const {Content}=await render(job);const applicationEmail=siteFor(lang).contact.applicationEmail||siteFor(lang).contact.email;
---
<ArticleLayout title={job.data.title} description={job.data.summary} date={job.data.mainControl.publishDate} section={ui.nav.careers} sectionUrl="/careers"><p class="lead">{job.data.department} · {job.data.location} · {job.data.employmentType}</p>{job.data.mainControl.closingDate && <p>{ui.headings.closingDate}: <time datetime={job.data.mainControl.closingDate.toISOString()}>{job.data.mainControl.closingDate.toLocaleDateString(lang==='kh'?'km-KH':'en-US',{day:'numeric',month:'long',year:'numeric'})}</time></p>}<div class="prose"><Content/><h2>{ui.headings.responsibilities}</h2><ul>{job.data.responsibilities.map(item=><li>{item}</li>)}</ul><h2>{ui.headings.requirements}</h2><ul>{job.data.requirements.map(item=><li>{item}</li>)}</ul></div><div class="notice application-notice"><h2>{ui.headings.apply}</h2>{applicationEmail?<p>{ui.application.emailPrefix} <a href={`mailto:${applicationEmail}?subject=${encodeURIComponent(`${ui.application.subject}: ${job.data.title}`)}`}>{applicationEmail}</a> {ui.application.emailSuffix}</p>:<p>{ui.application.fallbackPrefix} <a href={pathFor('/contact',lang)}>{ui.application.fallbackLink}</a> {ui.application.fallbackSuffix}</p>}</div></ArticleLayout>
