---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {contentFor,language,pathFor} from '../lib/content';
const lang=language(Astro.url),{about,ui}=contentFor(lang);
---
<BaseLayout title={ui.nav.about} description={about.hero.description}>
  <Hero {...about.hero}/>

  <section class="section owner-section owner-section-first">
    <div class="container">
      <article class="owner-panel owner-panel-modern">
        <div class="owner-photo-column">
          <div
            class="owner-photo-wrap background-image-block"
            role="img"
            aria-label={about.owner.photoAlt}
            style={`--bg-image: url("${about.owner.photo}")`}
          ></div>
          <div class="owner-photo-meta">
            <strong>{about.owner.name}</strong>
            <span>{about.owner.position}</span>
          </div>
        </div>

        <div class="owner-copy owner-copy-modern">
          <p class="eyebrow">{about.owner.eyebrow}</p>
          <h2>{about.owner.title}</h2>
          <div class="owner-quote-mark" aria-hidden="true">“</div>
          <p class="owner-message">{about.owner.message}</p>
          <div class="owner-signature owner-signature-modern">
            <span class="owner-signature-line" aria-hidden="true"></span>
            <div>
              <strong>{about.owner.name}</strong>
              <span>{about.owner.position}</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section about-overview-section">
    <div class="container split about-overview-split">
      <div class="split-copy">
        <p class="eyebrow about-overview-eyebrow">ABOUT LM MANUFACTURING</p>
        <h2>{about.overviewTitle}</h2>
        <p>{about.overviewText}</p>
        <h3 class="subheading">{about.storyTitle}</h3>
        <p>{about.storyText}</p>
      </div>
      <div class="about-overview-image-wrap">
        <img class="split-image" src={about.image} alt={about.imageAlt} width="700" height="530" loading="lazy"/>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container grid-3">
      <article><p class="eyebrow">{ui.headings.mission}</p><h2 class="small-heading">{ui.headings.mission}</h2><p>{about.mission}</p></article>
      <article><p class="eyebrow">{ui.headings.vision}</p><h2 class="small-heading">{ui.headings.vision}</h2><p>{about.vision}</p></article>
      <article><p class="eyebrow">{ui.headings.values}</p><h2 class="small-heading">{ui.headings.values}</h2>{about.values.map(v=><p><strong>{v.title}:</strong> {v.text}</p>)}</article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader title={ui.headings.journey}/>
      <div class="content-list">{about.milestones.map(m=><div class="milestone"><strong>{m.year}</strong><p>{m.event}</p></div>)}</div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container cta-panel"><h2>{about.ctaTitle}</h2><a class="button button-primary" href={pathFor('/contact',lang)}>{ui.actions.contact} <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
