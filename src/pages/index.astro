---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import SectionHeader from '../components/SectionHeader.astro';import ProductCard from '../components/ProductCard.astro';import NewsCard from '../components/NewsCard.astro';import {contentFor,language,pathFor,publicEntries,byNewest,productsFor,newsFor} from '../lib/content';const lang=language(Astro.url),{home,ui}=contentFor(lang);
const products=publicEntries(await productsFor(lang)).filter(p=>p.data.mainControl.featured).sort((a,b)=>a.data.mainControl.displayOrder-b.data.mainControl.displayOrder).slice(0,3);
const news=publicEntries(await newsFor(lang)).sort(byNewest).slice(0,3);
---
<BaseLayout><Hero {...home.hero} home/><section class="section"><div class="container split"><div class="split-copy"><p class="eyebrow">{home.intro.eyebrow}</p><h2>{home.intro.title}</h2><p>{home.intro.text}</p><a class="button button-outline" href={pathFor('/about',lang)}>{ui.actions.about} <span aria-hidden="true">↗</span></a></div><img class="split-image" src={home.intro.image} alt={home.intro.imageAlt} width="700" height="530" loading="lazy"/></div></section><section class="container" aria-label={ui.accessibility.statistics}><div class="stats">{home.statistics.map(stat=><div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section><section class="section"><div class="container"><div class="section-row"><SectionHeader title={home.productsHeading} text={home.productsDescription}/><a class="text-link" href={pathFor('/products',lang)}>{ui.actions.allProducts} <span aria-hidden="true">↗</span></a></div>{products.length?<div class="grid-3">{products.map(product=><ProductCard {product}/>)}</div>:<p>{ui.empty.featuredProducts}</p>}</div></section><section class="section section-muted"><div class="container split"><img class="split-image" src={home.factoryImage} alt={home.factoryImageAlt} width="700" height="530" loading="lazy"/><div class="split-copy"><h2>{home.factoryHeading}</h2><p>{home.factoryText}</p><a class="button button-outline" href={pathFor('/factory',lang)}>{ui.actions.factory} <span aria-hidden="true">↗</span></a></div></div></section><section class="section"><div class="container"><SectionHeader title={home.benefitsHeading}/><div class="feature-list">{home.benefits.map(item=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section><section class="section section-muted"><div class="container"><div class="section-row"><SectionHeader title={home.newsHeading}/><a class="text-link" href={pathFor('/news',lang)}>{ui.actions.allNews} <span aria-hidden="true">↗</span></a></div>{news.length?<div class="grid-3">{news.map(article=><NewsCard {article}/>)}</div>:<p>{ui.empty.homeNews}</p>}</div></section><section class="section section-dark"><div class="container cta-panel"><div><h2>{home.cta.title}</h2><p>{home.cta.text}</p></div><a class="button button-primary" href={pathFor(home.cta.url,lang)}>{home.cta.label} <span aria-hidden="true">↗</span></a></div></section></BaseLayout>
