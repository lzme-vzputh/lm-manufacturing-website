---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import NewsCard from '../components/NewsCard.astro';
import {contentFor,language,pathFor,publicEntries,byNewest,productsFor,newsFor} from '../lib/content';
const lang=language(Astro.url),{home,ui}=contentFor(lang);
const products=publicEntries(await productsFor(lang)).filter(p=>p.data.mainControl.featured).sort((a,b)=>a.data.mainControl.displayOrder-b.data.mainControl.displayOrder).slice(0,3);
const news=publicEntries(await newsFor(lang)).sort(byNewest).slice(0,3);
const singleProduct=products.length===1?products[0]:undefined;
---
<BaseLayout>
  <Hero {...home.hero} home/>

  <section class="home-intro section">
    <div class="container home-intro-grid">
      <div class="home-intro-heading">
        <p class="eyebrow">{home.intro.eyebrow}</p>
        <h2>{home.intro.title}</h2>
      </div>
      <div class="home-intro-copy">
        <p>{home.intro.text}</p>
        <a class="text-link home-arrow-link" href={pathFor('/about',lang)}>{ui.actions.about} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div
      class="container home-intro-media background-image-block"
      role="img"
      aria-label={home.intro.imageAlt}
      style={`--bg-image: url("${home.intro.image}")`}
    >
      <div class="home-intro-stats" aria-label={ui.accessibility.statistics}>
        {home.statistics.map(stat=><div class="home-stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section home-product-section">
    <div class="container">
      <div class="section-row home-section-row">
        <SectionHeader title={home.productsHeading} text={home.productsDescription}/>
        <a class="text-link" href={pathFor('/products',lang)}>{ui.actions.allProducts} <span aria-hidden="true">↗</span></a>
      </div>
      {singleProduct ? (
        <article class="home-product-feature">
          <div class="home-product-copy">
            <p class="eyebrow">{singleProduct.data.category}</p>
            <h3>{singleProduct.data.title}</h3>
            <p>{singleProduct.data.shortDescription}</p>
            <a class="button button-dark" href={pathFor(`/products/${singleProduct.data.slug}`,lang)}>{ui.actions.viewProduct} <span aria-hidden="true">↗</span></a>
          </div>
          <a class="home-product-visual" href={pathFor(`/products/${singleProduct.data.slug}`,lang)} aria-label={`${ui.actions.viewProduct}: ${singleProduct.data.title}`}>
            <img src={singleProduct.data.mainControl.mainImage} alt={singleProduct.data.mainImageAlt} width="850" height="850" loading="eager"/>
          </a>
        </article>
      ) : products.length ? (
        <div class="grid-3 home-product-grid">{products.map(product=><ProductCard {product}/>)}</div>
      ) : <p>{ui.empty.featuredProducts}</p>}
    </div>
  </section>

  <section class="section home-factory-section">
    <div class="container home-factory-grid">
      <div
        class="home-factory-visual background-image-block"
        role="img"
        aria-label={home.factoryImageAlt}
        style={`--bg-image: url("${home.factoryImage}")`}
      >
        <span class="factory-label">LM · KAMPONG SPEU</span>
      </div>
      <div class="home-factory-copy">
        <p class="eyebrow">MANUFACTURING</p>
        <h2>{home.factoryHeading}</h2>
        <p class="lead-copy">{home.factoryText}</p>
        <div class="home-benefit-list">
          {home.benefits.map((item,index)=><article><span>0{index+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}
        </div>
        <a class="button button-outline" href={pathFor('/factory',lang)}>{ui.actions.factory} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section home-news-section">
    <div class="container">
      <div class="section-row home-section-row"><SectionHeader title={home.newsHeading}/><a class="text-link" href={pathFor('/news',lang)}>{ui.actions.allNews} <span aria-hidden="true">↗</span></a></div>
      {news.length?<div class="grid-3 home-news-grid">{news.map(article=><NewsCard {article}/>)}</div>:<p>{ui.empty.homeNews}</p>}
    </div>
  </section>

  <section class="home-contact-band">
    <div class="container home-contact-inner">
      <div><p class="eyebrow">LM MANUFACTURING</p><h2>{home.cta.title}</h2><p>{home.cta.text}</p></div>
      <a class="button button-primary button-large" href={pathFor(home.cta.url,lang)}>{home.cta.label} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
