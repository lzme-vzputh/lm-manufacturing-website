---
import Home from '../index.astro';import About from '../about.astro';import Factory from '../factory.astro';import Contact from '../contact.astro';import Manage from '../manage.astro';import Products from '../products/index.astro';import News from '../news/index.astro';import Careers from '../careers/index.astro';
import Product from '../products/[slug].astro';import Story from '../news/[slug].astro';import Career from '../careers/[slug].astro';
import {productsFor,newsFor,careersFor} from '../../lib/content';
export async function getStaticPaths(){
 const routes=['','about','factory','contact','manage','products','news','careers'].map(path=>({params:{path:path||undefined}}));
 for(const [segment,entries] of [['products',await productsFor('kh')],['news',await newsFor('kh')],['careers',await careersFor('kh')] ] as const){
  for(const entry of entries) if(entry.data.published && (segment!=='careers'||String(entry.collection)==='careersKh')) routes.push({params:{path:`${segment}/${entry.data.slug}`},props:{entry}} as any);
 }
 return routes;
}
const path=Astro.params.path||'';const entry=(Astro.props as {entry?:any}).entry;
---
{path===''?<Home/>:path==='about'?<About/>:path==='factory'?<Factory/>:path==='contact'?<Contact/>:path==='manage'?<Manage/>:path==='products'?<Products/>:path==='news'?<News/>:path==='careers'?<Careers/>:path.startsWith('products/')?<Product product={entry}/>:path.startsWith('news/')?<Story article={entry}/>:<Career job={entry}/>}
