---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publicEntries, language, contentFor, pathFor } from '../../lib/content';

export async function getStaticPaths() {
  return publicEntries(await getCollection('products')).map(product => ({ params: { slug: product.data.slug }, props: { product } }));
}

const lang = language(Astro.url);
const ui = contentFor(lang).ui;
const { product } = Astro.props;
const { Content } = await render(product);
---
<BaseLayout title={product.data.title} description={product.data.shortDescription} image={product.data.mainControl.mainImage}>
  <section class="product-detail-hero-section">
    <div class="container product-detail-shell">
      <a class="product-detail-back" href={pathFor('/products', lang)}>
        <span aria-hidden="true">←</span> {ui.nav.products}
      </a>

      <article class="product-detail-hero-card">
        <div class="product-detail-copy">
          <p class="eyebrow">{product.data.category}</p>
          <h1>{product.data.title}</h1>
          <p class="product-detail-summary">{product.data.shortDescription}</p>
        </div>

        <div class="product-detail-pack-stage">
          <img
            class="product-detail-pack-image"
            src={product.data.mainControl.mainImage}
            alt={product.data.mainImageAlt}
            width="900"
            height="1200"
            loading="eager"
          />
        </div>
      </article>
    </div>
  </section>

  {(product.body || product.data.specifications.length > 0 || product.data.mainControl.gallery.length > 0) && (
    <section class="section product-detail-content-section">
      <div class="container product-detail-content-wrap">
        <div class="prose product-detail-prose"><Content /></div>

        {product.data.specifications.length > 0 && (
          <dl class="detail-list product-detail-specs">
            {product.data.specifications.map(spec => <><dt>{spec.label}</dt><dd>{spec.value}</dd></>)}
          </dl>
        )}

        {product.data.mainControl.gallery.length > 0 && (
          <div class="gallery detail-gallery product-detail-gallery">
            {product.data.mainControl.gallery.map(item => (
              <img src={item.image} alt={item.alt} width="600" height="450" loading="lazy" />
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>
