---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCarousel from '../../components/ProductCarousel.astro';
import {publicEntries,language,contentFor,productsFor,pathFor} from '../../lib/content';
const lang=language(Astro.url),{ui,productsPage}=contentFor(lang);
const products=publicEntries(await productsFor(lang)).sort((a,b)=>a.data.mainControl.displayOrder-b.data.mainControl.displayOrder);
const singleProduct=products.length===1?products[0]:undefined;
---
<BaseLayout title={ui.nav.products} description={productsPage.seoDescription}>
  <Hero {...productsPage.hero}/>
  <section class="section">
    <div class="container">
      {singleProduct ? (
        <article class="single-product-showcase">
          <div class="single-product-copy">
            <span class="eyebrow">{singleProduct.data.category}</span>
            <h2>{singleProduct.data.title}</h2>
            <p>{singleProduct.data.shortDescription}</p>
          </div>
          <a class="single-product-image-link" href={pathFor(`/products/${singleProduct.data.slug}`,lang)} aria-label={`${ui.actions.viewProduct}: ${singleProduct.data.title}`}>
            <img class="single-product-image" src={singleProduct.data.mainControl.mainImage} alt={singleProduct.data.mainImageAlt} width="820" height="820" loading="eager"/>
          </a>
          <a class="button button-primary" href={pathFor(`/products/${singleProduct.data.slug}`,lang)}>{ui.actions.viewProduct} <span aria-hidden="true">↗</span></a>
        </article>
      ) : products.length ? (
        <ProductCarousel products={products} lang={lang} viewLabel={ui.actions.viewProduct} />
      ) : <p>{ui.empty.products}</p>}
    </div>
  </section>
</BaseLayout>
<script is:inline src="/scripts/product-filter.js"></script>
<script is:inline src="/scripts/product-carousel.js"></script>
