---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/content';
const editorUrl = 'https://app.pagescms.org/';
const sections = [
  { name: 'Home', path: '/', description: 'Hero, introduction, statistics and featured sections.' },
  { name: 'About Us', path: '/about', description: 'Company story, mission, values and milestones.' },
  { name: 'Factory', path: '/factory', description: 'Facilities, capabilities, quality and gallery.' },
  { name: 'Products', path: '/products', description: 'Add products, change images and publish items.' },
  { name: 'News', path: '/news', description: 'Write articles, set dates and publish updates.' },
  { name: 'Careers', path: '/careers', description: 'Add jobs and publish or close positions.' },
  { name: 'Contact', path: '/contact', description: 'Contact page text and location map.' },
  { name: 'Company Settings', path: '/contact', description: 'Company name, logo, address, phone, email and social links.' },
];
---
<BaseLayout title="Website management" description={`Content editing access for ${site.companyName}.`}>
  <section class="management-heading"><div class="container">
    <p class="eyebrow">WEBSITE MANAGEMENT</p>
    <h1>Keep your website up to date.</h1>
    <p class="lead">Choose a section, edit its content in Pages CMS, and save. Your website updates after Cloudflare finishes the new deployment.</p>
    <a class="button button-primary" href={editorUrl} target="_blank" rel="noopener noreferrer">Open content editor <span aria-hidden="true">↗</span></a>
  </div></section>
  <section class="section" aria-labelledby="sections-heading"><div class="container">
    <div class="section-heading"><p class="eyebrow">CONTENT AREAS</p><h2 id="sections-heading">What you can manage</h2></div>
    <div class="management-grid">{sections.map(section => <article class="management-card">
      <h3>{section.name}</h3><p>{section.description}</p>
      <div class="management-links">
        <a href={editorUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open editor to edit ${section.name}`}>Edit in CMS <span aria-hidden="true">↗</span></a>
        <a href={section.path} aria-label={`View ${section.name} on website`}>View page</a>
      </div>
    </article>)}</div>
  </div></section>
  <section class="section section-muted" aria-labelledby="workflow-heading"><div class="container management-steps">
    <div><p class="eyebrow">HOW IT WORKS</p><h2 id="workflow-heading">Edit. Save. Review.</h2></div>
    <ol>
      <li><strong>Sign in</strong><span>Open Pages CMS and select your GitHub repository.</span></li>
      <li><strong>Edit content</strong><span>Choose the page or collection, change the text or image, and click Save.</span></li>
      <li><strong>Check the website</strong><span>Wait for the Cloudflare deployment to finish, then refresh the public page.</span></li>
    </ol>
  </div></section>
</BaseLayout>
<style>
  .management-heading{padding:clamp(4rem,8vw,7rem) 0;background:var(--dark);color:white}
  .management-heading h1{max-width:13ch;margin:.8rem 0 1.5rem}
  .management-heading .lead{max-width:43rem;color:#c8d6d8}
  .management-heading .button{margin-top:2rem}
  .management-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .management-card{display:flex;flex-direction:column;min-height:13rem;border:1px solid var(--line);padding:1.5rem;background:white}
  .management-card h3{font-size:1.45rem}
  .management-card p{margin-top:.8rem;color:var(--ink-soft)}
  .management-links{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:auto;padding-top:1.5rem;font-weight:700}
  .management-links a:first-child{color:#82551b}
  .management-steps{display:grid;grid-template-columns:1fr 1.4fr;gap:4rem}
  .management-steps ol{list-style:none;counter-reset:step}
  .management-steps li{counter-increment:step;display:grid;grid-template-columns:2.5rem 1fr;gap:.2rem 1rem;padding:1rem 0;border-top:1px solid var(--line)}
  .management-steps li:before{content:counter(step,decimal-leading-zero);grid-row:span 2;color:#82551b;font-weight:750}
  .management-steps li span{color:var(--ink-soft)}
  @media(max-width:700px){.management-grid,.management-steps{grid-template-columns:1fr}.management-steps{gap:2rem}}
</style>
