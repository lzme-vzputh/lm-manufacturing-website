---
import BaseLayout from '../layouts/BaseLayout.astro';
import {contentFor,language,pathFor} from '../lib/content';
const lang=language(Astro.url),ui=contentFor(lang).ui;const editorUrl='https://app.pagescms.org/';
const t=ui.manage;const sections=ui.manageSections;
---
<BaseLayout title={t.title} description={t.intro}>
 <section class="management-heading"><div class="container"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="lead">{t.intro}</p><a class="button button-primary" href={editorUrl} target="_blank" rel="noopener noreferrer">{t.open} ↗</a><p class="management-note">{t.note}</p></div></section>
 <section class="section"><div class="container"><div class="section-heading"><h2>{t.areas}</h2></div><div class="management-grid">{sections.map(({name,path,description})=><article class="management-card"><h3>{name}</h3><p>{description}</p><div class="management-links"><a href={editorUrl} target="_blank" rel="noopener noreferrer">{t.edit} ↗</a><a href={pathFor(path,lang)}>{t.view}</a></div></article>)}</div></div></section>
 <section class="section section-muted"><div class="container management-steps"><h2>{t.steps}</h2><ol><li><strong>{t.sign}</strong><span>{t.signText}</span></li><li><strong>{t.change}</strong><span>{t.changeText}</span></li><li><strong>{t.review}</strong><span>{t.reviewText}</span></li></ol></div></section>
</BaseLayout>
<style>
.management-heading{padding:clamp(4rem,8vw,7rem) 0;background:var(--dark);color:white}.management-heading h1{max-width:15ch;margin:.8rem 0 1.5rem}.management-heading .lead{max-width:44rem;color:#d9e3e5}.management-heading .button{margin-top:2rem}.management-note{max-width:48rem;margin-top:1.5rem;color:#d9e3e5}.management-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.management-card{display:flex;flex-direction:column;min-height:13rem;border:1px solid var(--line);padding:1.5rem;background:var(--surface)}.management-card h3{font-size:1.45rem}.management-card p{margin-top:.8rem;color:var(--ink-soft)}.management-links{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:auto;padding-top:1.5rem;font-weight:700}.management-links a:first-child{color:var(--link)}.management-steps{display:grid;grid-template-columns:1fr 1.4fr;gap:4rem}.management-steps ol{list-style:none;counter-reset:step}.management-steps li{counter-increment:step;display:grid;grid-template-columns:2.5rem 1fr;gap:.2rem 1rem;padding:1rem 0;border-top:1px solid var(--line)}.management-steps li:before{content:counter(step,decimal-leading-zero);grid-row:span 2;color:var(--link);font-weight:750}.management-steps li span{color:var(--ink-soft)}@media(max-width:700px){.management-grid,.management-steps{grid-template-columns:1fr}.management-steps{gap:2rem}}
</style>
